PROGRAM  = $(BINDIR)/$(BENCHMARK).$(CLASS).x
FCOMPILE = $(MPIFC) -c $(FMPI_INC) $(FFLAGS)
CCOMPILE = $(MPICC) -c $(CMPI_INC) $(CFLAGS)

# Class "U" is used internally by the setparams program to mean
# "unknown". This means that if you don't specify CLASS=
# on the command line, you'll get an error. It would be nice
# to be able to avoid this, but we'd have to get information
# from the setparams back to the make program, which isn't easy. 
CLASS=U

default:: ${PROGRAM}

# This makes sure the configuration utility setparams 
# is up to date. 
# Note that this must be run every time, which is why the
# target does not exist and is not created. 
# If you create a file called "config" you will break things. 
config:
	@cd ../sys; ${MAKE} all
	../sys/setparams ${BENCHMARK} ${CLASS} ${SUBTYPE}

COMMON=../common

# ----- TacVar measurement library (build-time conf) -----
# Variable defs must come before object rules that reference TACVAR_GEN_H.
# Evaluated from each benchmark subdirectory (e.g. BT/, IS/).
TACVAR_ROOT    ?= $(abspath ../../../../src/measure)
TACVAR_CONF    ?= $(abspath ../tacvar.conf)
TACVAR_OUTDIR  ?= $(abspath ../config/tacvar_build_$(shell uname -m))
TACVAR_GEN_H   = $(TACVAR_OUTDIR)/tacvar_generated_config.h
TACVAR_GEN_MK  = $(TACVAR_OUTDIR)/tacvar_generated_config.mk
TACVAR_LIB     = $(TACVAR_OUTDIR)/libtacvar_measure.a
PAPI_HOME      ?= /home/hpckey/01-App/papi-7.1.0
TACVAR_EXTRA_LIBS ?=
TACVAR_CFLAGS = -D_GNU_SOURCE -I$(TACVAR_ROOT)/include -I$(TACVAR_OUTDIR) -I$(COMMON) \
	-I$(TACVAR_ROOT)/timers -I$(TACVAR_ROOT)/counters -I$(TACVAR_ROOT) \
	-I$(PAPI_HOME)/include \
	-DTACVAR_HAS_GENERATED_CONFIG -include $(TACVAR_GEN_H)

${COMMON}/${RAND}.o: ${COMMON}/${RAND}.f90
	cd ${COMMON}; ${FCOMPILE} ${RAND}.f90
${COMMON}/c_randdp.o: ${COMMON}/randdp.c
	cd ${COMMON}; ${CCOMPILE} -o c_randdp.o randdp.c

${COMMON}/get_active_nprocs.o: ${COMMON}/get_active_nprocs.f90 ${COMMON}/mpinpb.h
	cd ${COMMON}; ${FCOMPILE} get_active_nprocs.f90

${COMMON}/mpinpb.h: ${COMMON}/mpinpb_${F08}.h
	cd ${COMMON}; cp mpinpb_${F08}.h mpinpb.h

${COMMON}/print_results.o: ${COMMON}/print_results.f90
	cd ${COMMON}; ${FCOMPILE} print_results.f90

${COMMON}/c_print_results.o: ${COMMON}/c_print_results.c
	cd ${COMMON}; ${CCOMPILE} c_print_results.c

${COMMON}/timers.o: ${COMMON}/timers.f90
	cd ${COMMON}; ${FCOMPILE} timers.f90

${COMMON}/c_timers.o: ${COMMON}/c_timers.c ../config/make.def ${TACVAR_GEN_H}
	cd ${COMMON}; ${CCOMPILE} $(TACVAR_CFLAGS) c_timers.c

${COMMON}/tacvar_npb.o: ${COMMON}/tacvar_npb.c ${COMMON}/tacvar_npb.h \
		${COMMON}/tacvar_npb_regions.h ../config/make.def ${TACVAR_GEN_H}
	cd ${COMMON}; ${CCOMPILE} $(TACVAR_CFLAGS) tacvar_npb.c

${COMMON}/tacvar_npb_regions.o: ${COMMON}/tacvar_npb_regions.c \
		${COMMON}/tacvar_npb_regions.h ../config/make.def ${TACVAR_GEN_H}
	cd ${COMMON}; ${CCOMPILE} $(TACVAR_CFLAGS) tacvar_npb_regions.c

# Normally setparams updates npbparams.h only if the settings (CLASS)
# have changed. However, we also want to update if the compile options
# may have changed (set in ../config/make.def).
npbparams.h: ../config/make.def
	@ echo make.def modified. Rebuilding npbparams.h just in case
	rm -f npbparams.h
	../sys/setparams ${BENCHMARK} ${CLASS} ${SUBTYPE}

# So that "make benchmark-name" works
${BENCHMARK}:  default
${BENCHMARKU}: default

.SUFFIXES:
.SUFFIXES: .c .h .f90 .f .o

$(TACVAR_GEN_H) $(TACVAR_GEN_MK): $(TACVAR_CONF) $(TACVAR_ROOT)/tools/gen_config.py
	@mkdir -p $(TACVAR_OUTDIR)
	python3 $(TACVAR_ROOT)/tools/gen_config.py --conf $(TACVAR_CONF) \
		--compiler $(MPICC) --consumer npb-mpi --outdir $(TACVAR_OUTDIR) \
		--measure-root $(TACVAR_ROOT) \
		--papi-inc $(PAPI_HOME)/include --papi-lib $(PAPI_HOME)/lib

$(TACVAR_LIB): $(TACVAR_GEN_H)
	$(MAKE) -C $(TACVAR_ROOT) CONF=$(TACVAR_CONF) CONSUMER=npb-mpi \
		OUTDIR=$(TACVAR_OUTDIR) CC=$(MPICC) \
		PAPI_INC=$(PAPI_HOME)/include PAPI_LIB=$(PAPI_HOME)/lib

# Inject TacVar into every benchmark link without editing per-bench Makefiles.
FMPI_LIB += $(COMMON)/tacvar_npb.o $(COMMON)/tacvar_npb_regions.o $(TACVAR_LIB) $(TACVAR_EXTRA_LIBS)
CMPI_LIB += $(COMMON)/tacvar_npb.o $(COMMON)/tacvar_npb_regions.o $(TACVAR_LIB) $(TACVAR_EXTRA_LIBS)
# Skip include remake when only cleaning (avoids regenerating then deleting).
ifeq (,$(filter tacvar_clean,$(MAKECMDGOALS)))
-include $(TACVAR_GEN_MK)
ifneq ($(strip $(TACVAR_MEASURE_LDFLAGS)),)
TACVAR_EXTRA_LIBS += $(TACVAR_MEASURE_LDFLAGS)
endif
endif

# Ensure tacvar objects exist before linking PROGRAM
${PROGRAM}: $(TACVAR_LIB) ${COMMON}/tacvar_npb.o ${COMMON}/tacvar_npb_regions.o

# After editing tacvar.conf: make tacvar_clean && make <bench> CLASS=...
.PHONY: tacvar_clean
tacvar_clean:
	- rm -f $(COMMON)/tacvar_npb.o $(COMMON)/tacvar_npb_regions.o $(COMMON)/c_timers.o $(COMMON)/timers.o
	- rm -rf $(TACVAR_OUTDIR)

