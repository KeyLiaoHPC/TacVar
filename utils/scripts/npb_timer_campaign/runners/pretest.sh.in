#!/usr/bin/env bash
# Generated NPB-MPI timer campaign PRETEST. Do not edit; regenerate from campaign.json.
# @SPEC_DIGEST@
set -euo pipefail

RESULTS="@RESULTS_DIR@"
MPI_DIR="@SUITE_ROOT@"
MPI_HOME="@MPI_HOME@"
PAPI_HOME="@PAPI_HOME@"
EXPECTED_HOST="@HOSTNAME@"
EXPECTED_ARCH="@ARCH@"
EXPECTED_DIGEST="@SPEC_DIGEST@"
PRETEST_NP=@PRETEST_NP@
PRETEST_KERNEL="@PRETEST_KERNEL@"
PRETEST_CLASS="@PRETEST_CLASS@"
TACVAR_NSTP=@TACVAR_NSTP@
LOCK_PATH="@LOCK_PATH@"
PROFILES_JSON='@PROFILES_JSON@'
@BIND_ARRAY@

export PATH="${MPI_HOME}/bin:${PATH}"
export LD_LIBRARY_PATH="${MPI_HOME}/lib:${PAPI_HOME}/lib:${LD_LIBRARY_PATH:-}"

LOG="$RESULTS/preflight/pretest.log"
STATUS_JSON="$RESULTS/preflight/status.json"
mkdir -p "$RESULTS/preflight"
: >> "$LOG"
log() { echo "[$(date +%H:%M:%S)] $*" | tee -a "$LOG"; }

fail() {
  local msg="$1"
  log "FAIL: $msg"
  echo FAIL > "$RESULTS/preflight/STATUS"
  python3 - "$STATUS_JSON" "$msg" "$EXPECTED_DIGEST" <<'PY' || true
import json, sys, datetime
path, msg, dig = sys.argv[1], sys.argv[2], sys.argv[3]
payload = {
  "status": "FAIL",
  "message": msg,
  "spec_sha256": dig,
  "timestamp": datetime.datetime.now().isoformat(timespec="seconds"),
}
open(path, "w").write(json.dumps(payload, indent=2) + "\n")
PY
  exit 1
}

pass_all() {
  log "PASS pretest"
  echo PASS > "$RESULTS/preflight/STATUS"
  echo "$EXPECTED_DIGEST" > "$RESULTS/preflight/spec.sha256"
  python3 - "$STATUS_JSON" "$EXPECTED_DIGEST" <<'PY'
import json, sys, datetime
path, dig = sys.argv[1], sys.argv[2]
payload = {
  "status": "PASS",
  "spec_sha256": dig,
  "timestamp": datetime.datetime.now().isoformat(timespec="seconds"),
  "checks": ["host", "tools", "lock", "e0_schema", "counter_profiles"],
}
open(path, "w").write(json.dumps(payload, indent=2) + "\n")
PY
}

# ---- host / tools ----
HOST_NOW=$(hostname)
ARCH_NOW=$(uname -m)
if [[ "$HOST_NOW" != "$EXPECTED_HOST" && "$HOST_NOW" != "$EXPECTED_HOST".* ]]; then
  # Allow short hostname match
  if [[ "${HOST_NOW%%.*}" != "${EXPECTED_HOST%%.*}" ]]; then
    fail "hostname mismatch: got=$HOST_NOW expected=$EXPECTED_HOST"
  fi
fi
if [[ "$ARCH_NOW" != "$EXPECTED_ARCH" ]]; then
  fail "arch mismatch: got=$ARCH_NOW expected=$EXPECTED_ARCH"
fi
[[ -d "$MPI_DIR" ]] || fail "suite root missing: $MPI_DIR"
[[ -x "$MPI_HOME/bin/mpirun" ]] || fail "mpirun missing under $MPI_HOME"
[[ -x "$MPI_HOME/bin/mpicc" ]] || fail "mpicc missing under $MPI_HOME"
[[ -d "$PAPI_HOME" ]] || fail "PAPI_HOME missing: $PAPI_HOME"
[[ -f "$RESULTS/campaign.json" ]] || fail "campaign.json missing"
DIG_NOW=$(tr -d '[:space:]' < "$RESULTS/campaign.sha256")
[[ "$DIG_NOW" == "$EXPECTED_DIGEST" ]] || fail "campaign.sha256 mismatch vs embedded digest"

# ---- conflict detection (never kill) ----
conflict_pids=$(pgrep -u "$USER" -f 'mpirun.*(NPB3\.4-MPI|bin/(bt|cg|ep|ft|is|lu|mg|sp)\.)' || true)
if [[ -n "${conflict_pids:-}" ]]; then
  log "Conflicting same-user mpirun/NPB processes detected:"
  ps -fp $conflict_pids || true
  fail "aborting: conflicting campaign processes present (will not kill)"
fi

# ---- flock ----
exec 9>"$LOCK_PATH"
if ! flock -n 9; then
  fail "could not acquire lock $LOCK_PATH (another campaign holds it)"
fi
log "Acquired lock $LOCK_PATH"

# ---- restore tacvar.conf ----
ORIG_BAK="$RESULTS/tacvar.conf.orig"
if [[ ! -f "$ORIG_BAK" ]]; then
  cp "$MPI_DIR/tacvar.conf" "$ORIG_BAK"
fi
restore_conf() {
  if [[ -f "$ORIG_BAK" ]]; then
    cp -f "$ORIG_BAK" "$MPI_DIR/tacvar.conf"
    touch "$MPI_DIR/tacvar.conf"
  fi
  rm -f "$MPI_DIR"/tacvar.conf.*.bak 2>/dev/null || true
}
trap 'restore_conf' EXIT

apply_conf() {
  local timer="$1" backend="$2" names="$3" count="$4" nstp="$5"
  cat > "$MPI_DIR/tacvar.conf" <<EOF
# Generated by 00_pretest.sh — do not edit mid-run
TACVAR_TIMER=$timer
TACVAR_NSTP=$nstp
TACVAR_COUNTER_BACKEND=$backend
TACVAR_COUNTER_COUNT=$count
TACVAR_COUNTER_NAMES=$names
TACVAR_OUTPUT_ROOT=.
TACVAR_ENABLE_PER_STEP_TIMING=@PER_STEP@
EOF
}

force_rebuild() {
  local arch
  arch=$(uname -m)
  rm -rf "$MPI_DIR/config/tacvar_build" "$MPI_DIR/config/tacvar_build_${arch}"
  rm -f "$MPI_DIR/common/"*.o "$MPI_DIR/sys/setparams" "$MPI_DIR/bin/"*.x
  find "$MPI_DIR" -mindepth 2 -maxdepth 2 -type f -name '*.o' -delete 2>/dev/null || true
}

check_nonzero_events() {
  local data_dir="$1"
  shift
  python3 - "$data_dir" "$@" <<'PY'
import csv, glob, sys
data_dir = sys.argv[1]
names = sys.argv[2:]
files = sorted(glob.glob(data_dir + "/npb-mpi_*.csv"))
if not files:
    print("NO_CSV")
    sys.exit(2)
missing = []
for name in names:
    col = name + "_delta"
    ok = False
    for path in files:
        with open(path, newline="") as f:
            r = csv.DictReader(f)
            if col not in (r.fieldnames or []):
                continue
            for row in r:
                try:
                    if int(row[col]) != 0:
                        ok = True
                        break
                except (ValueError, TypeError):
                    pass
        if ok:
            break
    if not ok:
        missing.append(name)
if missing:
    print("ZERO:" + ",".join(missing))
    sys.exit(1)
print("OK")
sys.exit(0)
PY
}

nstp_for_timer() {
  local t="$1"
  case "$t" in
    cntvct_el0|cntvct_el0_dmb) echo "$TACVAR_NSTP" ;;
    *) echo 0 ;;
  esac
}

write_meta() {
  cat > "$RESULTS/meta.env" <<EOF
HOST=$(hostname)
ARCH=$(uname -m)
NPROC=$(nproc)
DATE=$(date -Iseconds)
MPI_HOME=$MPI_HOME
PAPI_HOME=$PAPI_HOME
MPI_VERSION=$("$MPI_HOME/bin/mpirun" --version 2>&1 | head -1)
PAPI_VERSION=$("$PAPI_HOME/bin/papi_version" 2>/dev/null || echo unknown)
SPEC_SHA256=$EXPECTED_DIGEST
CLASS=@CLASS@
CORES=@CORES@
PRETEST_KERNEL=$PRETEST_KERNEL
PRETEST_CLASS=$PRETEST_CLASS
EOF
}

bin_name() {
  local app="$1" cls="$2"
  echo "$(echo "$app" | tr '[:upper:]' '[:lower:]').${cls}.x"
}

run_probe() {
  local tag="$1" timer="$2" backend="$3" names="$4" count="$5"
  local dest="$RESULTS/preflight/$tag"
  local nstp out data_path csv0 rc chk
  mkdir -p "$dest"
  nstp=$(nstp_for_timer "$timer")
  log "=== probe $tag timer=$timer backend=$backend events=$names ==="
  apply_conf "$timer" "$backend" "$names" "$count" "$nstp"
  force_rebuild
  out="$dest/build_run.out"
  set +e
  (cd "$MPI_DIR" && make "$PRETEST_KERNEL" "CLASS=$PRETEST_CLASS") >"$out" 2>&1
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    cp -f "$out" "$dest/stdout.log"
    cp -f "$MPI_DIR/tacvar.conf" "$dest/tacvar.conf"
    echo FAIL > "$dest/STATUS"
    fail "probe $tag compile failed"
  fi
  rm -rf "$MPI_DIR"/data_????????T??????
  export NPB_TIMER_FLAG=@NPB_TIMER_FLAG@
  local bin
  bin=$(bin_name "$PRETEST_KERNEL" "$PRETEST_CLASS")
  set +e
  (cd "$MPI_DIR" && mpirun -np "$PRETEST_NP" "${BIND_ARGS[@]}" "./bin/$bin") >>"$out" 2>&1
  rc=$?
  set -e
  cat > "$dest/cmd.sh" <<EOF
#!/usr/bin/env bash
set -euo pipefail
export PATH=$MPI_HOME/bin:\$PATH
export LD_LIBRARY_PATH=$MPI_HOME/lib:$PAPI_HOME/lib:\${LD_LIBRARY_PATH:-}
export NPB_TIMER_FLAG=@NPB_TIMER_FLAG@
cd $(printf '%q' "$MPI_DIR")
mpirun -np $PRETEST_NP ${BIND_ARGS[*]} ./bin/$bin
EOF
  chmod +x "$dest/cmd.sh"
  cp -f "$MPI_DIR/tacvar.conf" "$dest/tacvar.conf"
  rm -rf "$dest"/data_????????T??????
  data=$(ls -dt "$MPI_DIR"/data_????????T?????? 2>/dev/null | head -1 || true)
  if [[ -n "${data:-}" ]]; then
    mv "$data" "$dest/"
  fi
  cp -f "$out" "$dest/stdout.log"
  data_path=$(ls -dt "$dest"/data_????????T?????? 2>/dev/null | head -1 || true)
  csv0=$(ls "$data_path"/npb-mpi_*.csv 2>/dev/null | head -1 || true)
  if ! grep -q SUCCESSFUL "$out"; then
    echo FAIL > "$dest/STATUS"
    fail "probe $tag NAS verification failed"
  fi
  if [[ -z "${data_path:-}" || -z "${csv0:-}" ]]; then
    echo FAIL > "$dest/STATUS"
    fail "probe $tag missing CSV/data"
  fi
  local ncsv
  ncsv=$(ls "$data_path"/npb-mpi_*.csv 2>/dev/null | wc -l)
  if [[ "$ncsv" -lt "$PRETEST_NP" ]]; then
    echo FAIL > "$dest/STATUS"
    fail "probe $tag expected >= $PRETEST_NP CSVs, got $ncsv"
  fi
  if [[ "$count" -eq 0 ]]; then
    if head -1 "$csv0" | grep -qE 'PAPI_|_delta'; then
      # allow region columns; fail only if counter backend columns appear unexpectedly
      :
    fi
  else
    IFS=',' read -r -a name_arr <<< "$names"
    set +e
    chk=$(check_nonzero_events "$data_path" "${name_arr[@]}")
    rc=$?
    set -e
    echo "$chk" > "$dest/nonzero_check.txt"
    python3 - "$dest/checks.json" "$chk" "$rc" "$names" <<'PY'
import json, sys
path, chk, rc, names = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
open(path, "w").write(json.dumps({
  "events": names.split(",") if names else [],
  "nonzero_check": chk,
  "rc": rc,
}, indent=2) + "\n")
PY
    if [[ $rc -ne 0 ]]; then
      echo FAIL > "$dest/STATUS"
      fail "probe $tag zero/missing event deltas: $chk (no hidden fallback)"
    fi
  fi
  echo PASS > "$dest/STATUS"
  log "PASS probe $tag"
}

# ---- main ----
write_meta
log "Results=$RESULTS digest=$EXPECTED_DIGEST"

# e0 schema smoke if any none profile exists
NEED_E0=$(python3 -c 'import json,sys; ps=json.loads(sys.argv[1]); print(1 if any(p.get("backend")=="none" for p in ps) else 0)' "$PROFILES_JSON")
if [[ "$NEED_E0" == "1" ]]; then
  run_probe "e0_none" "clock_gettime" "none" "" 0
fi

# every nonzero counter profile (exact events; fail closed)
python3 - "$PROFILES_JSON" <<'PY' > "$RESULTS/preflight/profiles.list"
import json, sys
for p in json.loads(sys.argv[1]):
    if p.get("backend") == "none":
        continue
    events = ",".join(p.get("events") or [])
    print(f'{p["name"]}|{p["backend"]}|{events}|{len(p.get("events") or [])}')
PY

while IFS='|' read -r pname backend names count; do
  [[ -z "${pname:-}" ]] && continue
  run_probe "$pname" "clock_gettime" "$backend" "$names" "$count"
done < "$RESULTS/preflight/profiles.list"

pass_all
log "Pretest complete. Generate fulltest only after this PASS."
exit 0
