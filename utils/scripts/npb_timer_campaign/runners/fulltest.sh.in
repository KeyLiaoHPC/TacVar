#!/usr/bin/env bash
# Generated NPB-MPI timer campaign FULLTEST. Do not edit; regenerate from campaign.json.
# @SPEC_DIGEST@
set -euo pipefail

RESULTS="@RESULTS_DIR@"
MPI_DIR="@SUITE_ROOT@"
MPI_HOME="@MPI_HOME@"
PAPI_HOME="@PAPI_HOME@"
EXPECTED_HOST="@HOSTNAME@"
EXPECTED_ARCH="@ARCH@"
EXPECTED_DIGEST="@SPEC_DIGEST@"
CLASS="@CLASS@"
TACVAR_NSTP=@TACVAR_NSTP@
LOCK_PATH="@LOCK_PATH@"
PROFILES_JSON='@PROFILES_JSON@'
KERNEL_NP_JSON='@KERNEL_NP_JSON@'
@BIND_ARRAY@
@KERNELS_ARRAY@
@TIMERS_ARRAY@

export PATH="${MPI_HOME}/bin:${PATH}"
export LD_LIBRARY_PATH="${MPI_HOME}/lib:${PAPI_HOME}/lib:${LD_LIBRARY_PATH:-}"

LOG="$RESULTS/fulltest.log"
STATUS_CSV="$RESULTS/run_status.csv"
mkdir -p "$RESULTS/runs" "$RESULTS/summary/figures"
: >> "$LOG"
log() { echo "[$(date +%H:%M:%S)] $*" | tee -a "$LOG"; }

fail() {
  log "FAIL: $1"
  echo FAILED > "$RESULTS/FULLTEST_STATUS"
  exit 1
}

# ---- digest / host gates ----
[[ -f "$RESULTS/preflight/STATUS" ]] || fail "missing preflight/STATUS"
grep -qx PASS "$RESULTS/preflight/STATUS" || fail "preflight not PASS"
PRE_SHA=$(tr -d '[:space:]' < "$RESULTS/preflight/spec.sha256")
[[ "$PRE_SHA" == "$EXPECTED_DIGEST" ]] || fail "preflight digest mismatch ($PRE_SHA vs $EXPECTED_DIGEST)"
DIG_NOW=$(tr -d '[:space:]' < "$RESULTS/campaign.sha256")
[[ "$DIG_NOW" == "$EXPECTED_DIGEST" ]] || fail "campaign.sha256 mismatch"
HOST_NOW=$(hostname)
if [[ "${HOST_NOW%%.*}" != "${EXPECTED_HOST%%.*}" ]]; then
  fail "hostname mismatch: got=$HOST_NOW expected=$EXPECTED_HOST"
fi
ARCH_NOW=$(uname -m)
[[ "$ARCH_NOW" == "$EXPECTED_ARCH" ]] || fail "arch mismatch: $ARCH_NOW vs $EXPECTED_ARCH"

conflict_pids=$(pgrep -u "$USER" -f 'mpirun.*(NPB3\.4-MPI|bin/(bt|cg|ep|ft|is|lu|mg|sp)\.)' || true)
if [[ -n "${conflict_pids:-}" ]]; then
  log "Conflicting same-user mpirun/NPB processes:"
  ps -fp $conflict_pids || true
  fail "aborting: conflicting campaign processes present (will not kill)"
fi

exec 9>"$LOCK_PATH"
if ! flock -n 9; then
  fail "could not acquire lock $LOCK_PATH"
fi
log "Acquired lock $LOCK_PATH"

ORIG_BAK="$RESULTS/tacvar.conf.orig"
if [[ ! -f "$ORIG_BAK" ]]; then
  cp "$MPI_DIR/tacvar.conf" "$ORIG_BAK"
fi
restore_conf() {
  if [[ -f "$ORIG_BAK" ]]; then
    cp -f "$ORIG_BAK" "$MPI_DIR/tacvar.conf"
    touch "$MPI_DIR/tacvar.conf"
  fi
  rm -f "$MPI_DIR"/tacvar.conf.*.bak 2>/dev/null || true
}
trap 'restore_conf' EXIT

apply_conf() {
  local timer="$1" backend="$2" names="$3" count="$4" nstp="$5"
  cat > "$MPI_DIR/tacvar.conf" <<EOF
# Generated by 01_fulltest.sh — do not edit mid-run
TACVAR_TIMER=$timer
TACVAR_NSTP=$nstp
TACVAR_COUNTER_BACKEND=$backend
TACVAR_COUNTER_COUNT=$count
TACVAR_COUNTER_NAMES=$names
TACVAR_OUTPUT_ROOT=.
TACVAR_ENABLE_PER_STEP_TIMING=@PER_STEP@
EOF
}

force_rebuild() {
  local arch
  arch=$(uname -m)
  rm -rf "$MPI_DIR/config/tacvar_build" "$MPI_DIR/config/tacvar_build_${arch}"
  rm -f "$MPI_DIR/common/"*.o "$MPI_DIR/sys/setparams" "$MPI_DIR/bin/"*.x
  find "$MPI_DIR" -mindepth 2 -maxdepth 2 -type f -name '*.o' -delete 2>/dev/null || true
}

nstp_for_timer() {
  local t="$1"
  case "$t" in
    cntvct_el0|cntvct_el0_dmb) echo "$TACVAR_NSTP" ;;
    *) echo 0 ;;
  esac
}

np_for_kernel() {
  local k="$1"
  python3 -c 'import json,sys; d=json.loads(sys.argv[1]); print(int(d[sys.argv[2]]))' "$KERNEL_NP_JSON" "$k"
}

combo_tag() {
  local timer="$1" pname="$2"
  echo "${timer}_${pname}"
}

run_dir() {
  local tag="$1" app="$2"
  echo "$RESULTS/runs/${tag}/$(echo "$app" | tr '[:upper:]' '[:lower:]')"
}

already_pass() {
  local dir="$1"
  [[ -f "$dir/STATUS" ]] && grep -qx 'PASS' "$dir/STATUS"
}

manifest_digest() {
  local timer="$1" pname="$2" backend="$3" names="$4" app="$5" np="$6"
  python3 - <<PY
import hashlib, json
obj = {
  "timer": "$timer",
  "profile": "$pname",
  "backend": "$backend",
  "events": [x for x in "$names".split(",") if x],
  "kernel": "$app",
  "np": int("$np"),
  "class": "$CLASS",
  "spec": "$EXPECTED_DIGEST",
}
print(hashlib.sha256(json.dumps(obj, sort_keys=True, separators=(",", ":")).encode()).hexdigest())
PY
}

append_status() {
  local tag="$1" app="$2" status="$3" note="$4"
  local tmp
  tmp=$(mktemp)
  if [[ -f "$STATUS_CSV" ]]; then
    # drop prior row for same tag/app
    awk -F, -v t="$tag" -v a="$app" 'NR==1 || !($1==t && toupper($2)==toupper(a))' "$STATUS_CSV" > "$tmp" || true
  else
    echo "tag,app,status,note,ts" > "$tmp"
  fi
  echo "${tag},${app},${status},${note},$(date -Iseconds)" >> "$tmp"
  mv -f "$tmp" "$STATUS_CSV"
}

archive_run() {
  local dest="$1" out="$2" status="$3"
  mkdir -p "$dest"
  cp -f "$MPI_DIR/tacvar.conf" "$dest/tacvar.conf"
  local data
  data=$(ls -dt "$MPI_DIR"/data_????????T?????? 2>/dev/null | head -1 || true)
  if [[ -n "$data" ]]; then
    local base
    base=$(basename "$data")
    rm -rf "$dest/$base"
    mv "$data" "$dest/"
  fi
  cp -f "$out" "$dest/stdout.log"
  echo "$status" > "$dest/STATUS"
}

run_one() {
  local timer="$1" pname="$2" backend="$3" names="$4" count="$5" app="$6"
  local tag nstp np bin dest out rc dig
  tag=$(combo_tag "$timer" "$pname")
  nstp=$(nstp_for_timer "$timer")
  np=$(np_for_kernel "$app")
  bin="$(echo "$app" | tr '[:upper:]' '[:lower:]').${CLASS}.x"
  dest=$(run_dir "$tag" "$app")
  dig=$(manifest_digest "$timer" "$pname" "$backend" "$names" "$app" "$np")

  if already_pass "$dest"; then
    if [[ -f "$dest/run-manifest.json" ]]; then
      local old
      old=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("digest",""))' "$dest/run-manifest.json")
      if [[ "$old" == "$dig" ]]; then
        log "SKIP $tag/$app (PASS + matching digest)"
        append_status "$tag" "$app" PASS "resume-skip"
        return 0
      fi
    fi
  fi

  mkdir -p "$dest"
  log "=== $tag / $app (np=$np) ==="
  apply_conf "$timer" "$backend" "$names" "$count" "$nstp"
  python3 - "$dest/run-manifest.json" "$dig" "$timer" "$pname" "$backend" "$names" "$app" "$np" <<'PY'
import json, sys
path, dig, timer, pname, backend, names, app, np = sys.argv[1:9]
open(path, "w").write(json.dumps({
  "digest": dig,
  "timer": timer,
  "profile": pname,
  "backend": backend,
  "events": [x for x in names.split(",") if x],
  "kernel": app,
  "np": int(np),
}, indent=2) + "\n")
PY

  out="$dest/build_run.out"
  set +e
  (cd "$MPI_DIR" && make "$app" "CLASS=$CLASS") >"$out" 2>&1
  rc=$?
  set -e
  cat > "$dest/cmd.sh" <<EOF
#!/usr/bin/env bash
set -euo pipefail
export PATH=$MPI_HOME/bin:\$PATH
export LD_LIBRARY_PATH=$MPI_HOME/lib:$PAPI_HOME/lib:\${LD_LIBRARY_PATH:-}
export NPB_TIMER_FLAG=@NPB_TIMER_FLAG@
cd $(printf '%q' "$MPI_DIR")
mpirun -np $np ${BIND_ARGS[*]} ./bin/$bin
EOF
  chmod +x "$dest/cmd.sh"

  if [[ $rc -ne 0 ]]; then
    archive_run "$dest" "$out" FAIL
    append_status "$tag" "$app" FAIL "compile"
    log "FAIL $tag/$app compile"
    return 0
  fi

  rm -rf "$MPI_DIR"/data_????????T??????
  export NPB_TIMER_FLAG=@NPB_TIMER_FLAG@
  set +e
  (cd "$MPI_DIR" && mpirun -np "$np" "${BIND_ARGS[@]}" "./bin/$bin") >>"$out" 2>&1
  rc=$?
  set -e

  if ! grep -q SUCCESSFUL "$out"; then
    archive_run "$dest" "$out" FAIL
    append_status "$tag" "$app" FAIL "verify"
    log "FAIL $tag/$app verification"
    return 0
  fi
  archive_run "$dest" "$out" PASS
  append_status "$tag" "$app" PASS "ok"
  log "PASS $tag/$app"
}

# ---- matrix ----
: > "$STATUS_CSV.tmp"
echo "tag,app,status,note,ts" > "$STATUS_CSV.tmp"
mv -f "$STATUS_CSV.tmp" "$STATUS_CSV"

# Expand profiles into lines: name|backend|events|count
python3 - "$PROFILES_JSON" <<'PY' > "$RESULTS/profiles.list"
import json, sys
for p in json.loads(sys.argv[1]):
    events = ",".join(p.get("events") or [])
    print(f'{p["name"]}|{p["backend"]}|{events}|{len(p.get("events") or [])}')
PY

ANY_FAIL=0
while IFS='|' read -r pname backend names count; do
  [[ -z "${pname:-}" ]] && continue
  for timer in "${TIMERS[@]}"; do
    log "=== rebuild combo ${timer}_${pname} ==="
    nstp=$(nstp_for_timer "$timer")
    apply_conf "$timer" "$backend" "$names" "$count" "$nstp"
    force_rebuild
    for app in "${KERNELS[@]}"; do
      run_one "$timer" "$pname" "$backend" "$names" "$count" "$app"
      if [[ -f "$(run_dir "$(combo_tag "$timer" "$pname")" "$app")/STATUS" ]] \
         && ! grep -qx PASS "$(run_dir "$(combo_tag "$timer" "$pname")" "$app")/STATUS"; then
        ANY_FAIL=1
      fi
    done
  done
done < "$RESULTS/profiles.list"

# Fail closed: every requested cell must exist and PASS
python3 - "$RESULTS" "$PROFILES_JSON" <<'PY'
import json, sys
from pathlib import Path
results = Path(sys.argv[1])
profiles = json.loads(sys.argv[2])
spec = json.loads((results / "campaign.json").read_text())
missing = []
failed = []
for timer in spec["timers"]:
    for p in profiles:
        for k in spec["kernels"]:
            tag = f'{timer}_{p["name"]}'
            d = results / "runs" / tag / k.lower()
            st = d / "STATUS"
            if not st.exists():
                missing.append(f"{tag}/{k}")
            elif st.read_text().strip() != "PASS":
                failed.append(f"{tag}/{k}:{st.read_text().strip()}")
if missing or failed:
    print("MISSING:" + ",".join(missing))
    print("FAILED:" + ",".join(failed))
    sys.exit(1)
print("COMPLETE")
PY
rc=$?
if [[ $rc -ne 0 ]]; then
  echo FAILED > "$RESULTS/FULLTEST_STATUS"
  fail "matrix incomplete or has FAIL cells"
fi

echo COMPLETE > "$RESULTS/FULLTEST_STATUS"
log "FULLTEST COMPLETE"
exit 0
